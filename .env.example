# Select live for device and release builds. Mock mode must be chosen deliberately for local UX smoke tests.
# The live URL must be the delivery-server origin without a trailing path.
# Only EXPO_PUBLIC_* values are bundled into the native app runtime.
EXPO_PUBLIC_DRIVER_RUNTIME_MODE=live
EXPO_PUBLIC_DELIVERY_SERVER_BASE_URL=https://delivery.example.com
# Local mock alternative: set EXPO_PUBLIC_DRIVER_RUNTIME_MODE=mock and leave the server URL unset.
